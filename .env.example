# GEMINI_API_KEY: Required if Gemini AI features are invoked server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server & Persistence Configuration
PORT="3000"
DATABASE_PATH="./data/maata.db"
MEDIA_STORAGE_DIR="./storage/media"

# Session & Security Configuration
# Generate a strong random 32+ character string in production
SESSION_SECRET=""
SESSION_TTL_HOURS="12"

# Optional Initial Super Admin Bootstrap (used only if no Super Admin exists yet)
# Leave blank to use the secure interactive first-run setup flow at /admin/login
ADMIN_BOOTSTRAP_NAME=""
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Set to "true" only in local/staging environments when SMTP email delivery is not configured
ALLOW_DEV_RESET_PREVIEW="true"
