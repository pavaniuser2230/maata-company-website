  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorised MAATA CMS and leadership user directory keyed by Firebase Auth UID."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Non-PII user display profile."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivatePii" },
      "description": "Isolated user PII subcollection restricted to account owner and admins."
    },
    "/companySections/{sectionKey}": {
      "schema": { "$ref": "#/entities/CompanySection" },
      "description": "Corporate page content sections synced with CMS."
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Newsroom articles with published/draft visibility."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Corporate announcements and website alert banners."
    },
    "/mediaAssets/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Approved brand assets and Founder Gallery metadata."
    },
    "/cmsTranslations/{translationId}": {
      "schema": { "$ref": "#/entities/CmsTranslation" },
      "description": "Published/draft localized CMS overrides across 9 Indian languages."
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Contact and feedback enquiries containing PII, protected from public reads."
    },
    "/leadershipWorkItems/{itemId}": {
      "schema": { "$ref": "#/entities/LeadershipWorkItem" },
      "description": "Confidential executive roadmap items (Founder read-only, CEO/Super Admin write)."
    },
    "/leadershipReports/{reportId}": {
      "schema": { "$ref": "#/entities/LeadershipReport" },
      "description": "Confidential leadership reports."
    },
    "/leadershipDocuments/{docId}": {
      "schema": { "$ref": "#/entities/LeadershipDocument" },
      "description": "Confidential company governance and strategy documents."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only security and CMS audit trail."
    }
  }
}
