        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "body": {
          "type": "string",
          "maxLength": 8000
